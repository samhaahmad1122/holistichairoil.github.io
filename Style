*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:'Poppins',sans-serif;
line-height:1.6;
background:#ffffff;
color:#333;
}

header{
background:#0f5132;
padding:15px 5%;
position:sticky;
top:0;
z-index:100;
}

nav{
display:flex;
justify-content:space-between;
align-items:center;
}

.logo{
color:white;
font-size:1.4rem;
font-weight:700;
}

nav ul{
display:flex;
list-style:none;
gap:20px;
}

nav a{
color:white;
text-decoration:none;
}

.hero{
display:flex;
align-items:center;
justify-content:center;
padding:80px 10%;
gap:50px;
flex-wrap:wrap;
}

.hero-text{
flex:1;
min-width:300px;
}

.hero-text h1{
font-size:3rem;
margin-bottom:20px;
color:#0f5132;
}

.hero-text p{
margin-bottom:30px;
}

.hero-image{
flex:1;
text-align:center;
}

.hero-image img{
width:100%;
max-width:400px;
border-radius:20px;
box-shadow:0 10px 25px rgba(0,0,0,0.15);
}

.btn{
display:inline-block;
background:#0f5132;
color:white;
padding:12px 28px;
border-radius:8px;
text-decoration:none;
}

.section{
padding:80px 10%;
text-align:center;
}

.section h2{
margin-bottom:25px;
color:#0f5132;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-top:30px;
}

.card{
padding:25px;
background:#f3f8f4;
border-radius:12px;
}

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.gallery img{
width:100%;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

.steps{
max-width:700px;
margin:auto;
text-align:left;
}

.contact{
background:#f6fbf7;
}

.socials{
margin-top:20px;
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.socials a{
text-decoration:none;
color:#0f5132;
font-weight:600;
}

footer{
background:#0f5132;
color:white;
text-align:center;
padding:20px;
}

@media(max-width:768px){

.hero{
padding:50px 5%;
}

.hero-text h1{
font-size:2.2rem;
}

nav{
flex-direction:column;
gap:10px;
}

nav ul{
flex-wrap:wrap;
justify-content:center;
}

}
